#!/usr/bin/env zsh

osascript -e 'tell application "System Preferences" to quit'

sudo -v
if [[ "$(uname -s)" == "Darwin" ]]; then
	sudo sh -c '
		file="/etc/pam.d/sudo_local"
		line="auth       sufficient     pam_tid.so"
		if [ ! -f "$file" ]; then
			printf "%s\n" "$line" > "$file"
			echo "Enabled Touch ID for sudo."
		elif ! grep -Eq "^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\\.so([[:space:]]|$)" "$file"; then
			printf "%s\n" "$line" >> "$file"
			echo "Enabled Touch ID for sudo."
		else
			echo "Touch ID for sudo already configured."
		fi
	'
fi

while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Library/Preferences

defaults write com.apple.dock persistent-apps -array #Empty dock
defaults write com.apple.dock autohide -bool true #Make dock auto-hide
defaults write com.apple.dock "tilesize" -int "60" #Make dock icons smaller
defaults write com.apple.dock "enable-spring-load-actions-on-all-items" -bool "true" #Enable spring loading for all dock items
defaults write com.apple.dock show-recents -bool false #Remove recent apps from dock
defaults write com.apple.dock "autohide-time-modifier" -float "0.1" #Make dock appear instantly
defaults write com.apple.dock "autohide-delay" -float "0.05" #Make dock appear instantly
defaults write com.apple.dock "scroll-to-open" -bool "true" #Scroll to open dock items


mkdir ~/Screenshots
defaults write com.apple.screencapture location -string "${HOME}/Screenshots" #Change screenshot location
defaults write com.apple.screencapture type -string "png" #Change screenshot format


defaults write NSGlobalDomain AppleShowAllExtensions -bool true #Show all filename extensions
defaults write com.apple.finder "AppleShowAllFiles" -bool "true" #Show hidden files in Finder
defaults write com.apple.finder "ShowPathbar" -bool "true" #Show path bar in Finder
defaults write com.apple.finder "_FXSortFoldersFirst" -bool "true" #Keep folders on top when sorting by name
defaults write com.apple.finder "FXEnableExtensionChangeWarning" -bool "false" #Disable warning when changing a file extension
defaults write NSGlobalDomain "NSTableViewDefaultSizeMode" -int "1" #Use small icons in Finder
defaults write com.apple.finder "ShowStatusBar" -bool "true" #Show status bar in Finder


defaults write com.apple.finder "ShowExternalHardDrivesOnDesktop" -bool "false" #Show external drives on desktop
defaults write com.apple.finder "ShowRemovableMediaOnDesktop" -bool "false" #Show removable media on desktop


# Trackpad: enable tap to click for this user and for the login screen
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
defaults write NSGlobalDomain com.apple.mouse.linear -bool "false" # Disables mouse acceleration
defaults write NSGlobalDomain com.apple.mouse.scaling -float "1" # Set mouse tracking speed
defaults write com.apple.AppleMultitouchTrackpad "FirstClickThreshold" -int "0" # Set trackpad click sensitivity
defaults write com.apple.AppleMultitouchTrackpad "DragLock" -bool "false"


defaults write NSGlobalDomain "ApplePressAndHoldEnabled" -bool "false" # Disable press-and-hold for keys in favor of key repeat
defaults write com.apple.HIToolbox AppleFnUsageType -int "0" # Don't start emoji keyboard with fn key
defaults write NSGlobalDomain com.apple.keyboard.fnState -bool false # Use special function keys as standard function keys
defaults write NSGlobalDomain AppleKeyboardUIMode -int "2" # Enable full keyboard access for all controls (e.g. enable Tab in modal dialogs)
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false # Disable automatic period substitution as it’s annoying when typing code


defaults write com.apple.appleseed.FeedbackAssistant "Autogather" -bool "false" # Don't automatically send feedback to Apple
defaults write com.apple.TextEdit "SmartQuotes" -bool "false" # Disable smart quotes as it’s annoying when typing code


defaults write com.apple.ActivityMonitor "UpdatePeriod" -int "2" # Update Activity Monitor to show all processes
defaults write com.apple.ActivityMonitor "IconType" -int "5" # Visualize CPU usage in Activity Monitor Dock icon

defaults write com.apple.LaunchServices "LSQuarantine" -bool "true" #Warn before opening downloaded applications

defaults write NSGlobalDomain "NSQuitAlwaysKeepsWindows" -bool "true" # Reopen windows when quitting and re-opening apps

defaults write com.apple.Safari ShowFullURLInSmartSearchField -bool true # Show the full URL in Safari's address bar


for app in "cfprefsd" \
    "Dock" \
    "Finder" \
    "SystemUIServer" \
    "Terminal"; do
    killall "${app}" &> /dev/null
done
echo "Done. Note that some of these changes require a logout/restart to take effect."