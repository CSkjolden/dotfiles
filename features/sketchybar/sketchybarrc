PLUGIN_DIR="$HOME/dotfiles/features/sketchybar/plugins"

sketchybar --bar position=top height=32 margin=2 y_offset=0 corner_radius=18 blur_radius=25 \
  color=0xb0181825 border_width=1 border_color=0x22ffffff padding_left=6 padding_right=6

sketchybar --default \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  label.font="SF Pro:Semibold:13.0"

# Left: workspaces, floating apps, unassigned apps. FlashSpace triggers updates (see features/flashspace/settings.toml).
sh "$PLUGIN_DIR/flashspace.sh" setup

# Right: Bluetooth, Wi-Fi, battery and clock.
sh "$PLUGIN_DIR/status.sh" setup

sketchybar --update
