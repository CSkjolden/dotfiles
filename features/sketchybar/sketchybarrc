PLUGIN_DIR="$HOME/dotfiles/features/sketchybar/plugins"

sketchybar --bar position=top height=32 margin=2 y_offset=0 corner_radius=0 blur_radius=0 \
  color=0x0 border_width=0 padding_left=6 padding_right=6

sketchybar --default \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  label.font="SF Pro:Semibold:13.0"

# Left: workspaces. AeroSpace triggers updates (see features/aerospace).
sh "$PLUGIN_DIR/aerospace.sh" setup

# Right: Bluetooth, Wi-Fi, battery and clock.
sh "$PLUGIN_DIR/status.sh" setup

sketchybar --update
